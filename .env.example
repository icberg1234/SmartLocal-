APP_NAME=SmartLocal
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=smartlocal
DB_USERNAME=smartlocal
DB_PASSWORD=secret

CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379

# --- External adapters (use fake drivers locally) ---
SMS_DRIVER=fake          # fake | kavenegar
KAVENEGAR_API_KEY=

PAYMENT_DRIVER=fake      # fake | zarinpal
ZARINPAL_MERCHANT_ID=

# Domain config (base data — see config/smartlocal.php)
POINT_UNIT=100000        # 1 point per 100,000 Toman of final amount
REDEEM_TOKEN_TTL=60      # seconds
REDEEM_VELOCITY_PER_DAY=3
POINTS_TTL_DAYS=180
NOTIF_DAILY_CAP=5
PARKING_LOTTERY_PCT=0

# OTP (login)
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=3
OTP_LOCK_MINUTES=10

# Branding / message templates (per-mall override via malls.settings)
APP_BRAND=SmartLocal
TPL_OTP_SMS="کد ورود {brand}: {code}"

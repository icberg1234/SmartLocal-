includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Level 5 for MVP start: full type checks without the verbose Laravel
    # relation/factory generics (those are reported at level 6+ in PHPStan 2.x).
    # Ratchet plan: 5 -> 6 (add relation generic phpdocs) -> max, per phase.
    level: 5
    paths:
        - app
        - database
    tmpDir: build/phpstan
